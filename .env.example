# Proyecto de GCP donde vive el dataset de BigQuery (03_BaseModel).
# Requerido solo para ejecutar reportes contra BigQuery real (fuera del alcance
# de los tests unitarios de Fase 1, que no tocan red).
GOOGLE_CLOUD_PROJECT=data-prd-424213

# Ruta a config/settings.yaml. Por defecto se usa la del repo.
REPORTING_AUTOMATION_SETTINGS=config/settings.yaml
