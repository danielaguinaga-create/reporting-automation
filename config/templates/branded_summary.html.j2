<!--
  Plantilla de ejemplo -- copiar/adaptar para un reporte real.
  Referenciar desde config/reports/**/*.yaml con:
    template: branded_summary
  Variables disponibles (ver rendering/template_engine.py):
    title, report {id,name,description}, client {id,display_name,branding},
    params, generated_at, rows, columns, row_count, truncated,
    extra_paragraphs (vacio salvo uso ad-hoc de `ask`).
-->
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  :root { --brand-color: {{ (client.branding.primary_color if client else None) or '#2c3e50' }}; }
  body { font-family: Helvetica, Arial, sans-serif; color: #222; background: #fff; margin: 2em; }
  header { display: flex; align-items: center; gap: 1em; border-bottom: 3px solid var(--brand-color); padding-bottom: 0.6em; margin-bottom: 1em; }
  header img { max-height: 48px; }
  h1 { font-size: 20px; margin: 0; color: var(--brand-color); }
  .subtitle { color: #666; font-size: 13px; margin-top: 0.2em; }
  .params { font-size: 12px; color: #555; margin-bottom: 1em; }
  table { border-collapse: collapse; width: 100%; font-size: 11px; }
  th, td { border: 1px solid #ccc; padding: 4px 8px; text-align: left; }
  th { background: var(--brand-color); color: white; }
  tr:nth-child(even) { background: #f7f7f7; }
  footer { margin-top: 1.5em; font-size: 10px; color: #999; }
  @page { size: landscape; margin: 1.5cm; }
</style>
</head>
<body>
  <header>
    {% if client and client.branding.logo_url %}
    <img src="{{ client.branding.logo_url }}" alt="{{ client.display_name }}">
    {% endif %}
    <div>
      <h1>{{ report.name if report else title }}</h1>
      <div class="subtitle">
        {{ client.display_name if client else "" }} &middot; generado el {{ generated_at }}
      </div>
    </div>
  </header>

  {% if params %}
  <div class="params">
    {% for k, v in params.items() %}<strong>{{ k }}</strong>: {{ v }}&nbsp;&nbsp;{% endfor %}
  </div>
  {% endif %}

  {% if truncated %}
  <p><em>Mostrando las primeras {{ rows | length }} de {{ row_count }} filas.</em></p>
  {% endif %}

  <table>
    <thead>
      <tr>{% for col in columns %}<th>{{ col }}</th>{% endfor %}</tr>
    </thead>
    <tbody>
      {% for row in rows %}
      <tr>{% for col in columns %}<td>{{ row[col] }}</td>{% endfor %}</tr>
      {% endfor %}
    </tbody>
  </table>

  <footer>Generado por reporting-automation &middot; {{ report.id if report else "" }}</footer>
</body>
</html>
